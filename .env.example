# Copier en .env.local et renseigner les valeurs de votre projet Supabase
# (Project Settings → API) pour activer les comptes et la synchronisation
# multi-appareils. Sans ces deux variables, l'app fonctionne normalement
# en local uniquement — la carte « Compte » du profil reste invisible.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
